PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://gymflow_app:local_dev_change_me@localhost:5432/gymflow?schema=public

# Autenticación
# Genera un secreto distinto por entorno, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_with_a_long_random_secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Usuarios iniciales del seed (cámbialos antes de usar datos reales)
SEED_ADMIN_EMAIL=admin@gymflow.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_RECEPTION_EMAIL=recepcion@gymflow.local
SEED_RECEPTION_PASSWORD=Recepcion123!
