// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

model Gym {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("America/Lima") @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members       Member[]
  plans         Plan[]
  memberships   Membership[]
  payments      Payment[]
  attendances   Attendance[]
  users         User[]
  events        Event[]
  reservations  Reservation[]
  eventPayments EventPayment[]
}

enum UserRole {
  ADMIN
  RECEPTION
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  gymId        String    @db.Uuid
  email        String    @db.VarChar(150)
  passwordHash String    @db.VarChar(255)
  firstName    String    @db.VarChar(100)
  lastName     String    @db.VarChar(100)
  role         UserRole  @default(RECEPTION)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Restrict)

  refreshTokens RefreshToken[]

  @@unique([gymId, email])
  @@index([gymId, role])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Member {
  id                        String       @id @default(uuid()) @db.Uuid
  gymId                     String       @db.Uuid
  firstName                 String       @db.VarChar(100)
  lastName                  String       @db.VarChar(100)
  documentNumber            String?      @db.VarChar(30)
  memberCode                String       @db.VarChar(30)
  phone                     String?      @db.VarChar(30)
  email                     String?      @db.VarChar(150)
  qrToken                   String       @unique @default(uuid()) @db.Uuid
  qrTokenRegeneratedAt      DateTime?    @db.Timestamptz(3)
  qrTokenRegenerationReason String?      @db.VarChar(255)
  status                    MemberStatus @default(ACTIVE)
  createdAt                 DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime     @updatedAt @db.Timestamptz(3)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Restrict)

  memberships  Membership[]
  payments     Payment[]
  attendances  Attendance[]
  reservations Reservation[]

  @@unique([gymId, documentNumber])
  @@unique([gymId, memberCode])
  @@index([gymId, lastName, firstName])
  @@index([gymId, status])
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  gymId        String   @db.Uuid
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(255)
  durationDays Int
  price        Decimal  @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@index([gymId, active])
}

model Membership {
  id                 String           @id @default(uuid()) @db.Uuid
  gymId              String           @db.Uuid
  memberId           String           @db.Uuid
  planId             String           @db.Uuid
  startDate          DateTime         @db.Date
  endDate            DateTime         @db.Date
  price              Decimal          @db.Decimal(10, 2)
  status             MembershipStatus @default(ACTIVE)
  cancelledAt        DateTime?        @db.Timestamptz(3)
  cancellationReason String?          @db.VarChar(255)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  payments    Payment[]
  attendances Attendance[]

  @@index([gymId, memberId])
  @@index([gymId, status])
  @@index([gymId, endDate])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  YAPE
  PLIN
  OTHER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
}

model Payment {
  id           String @id @default(uuid()) @db.Uuid
  gymId        String @db.Uuid
  memberId     String @db.Uuid
  membershipId String @db.Uuid

  amount         Decimal       @db.Decimal(10, 2)
  paymentDate    DateTime      @default(now()) @db.Timestamptz(3)
  method         PaymentMethod
  status         PaymentStatus @default(COMPLETED)
  reference      String?       @db.VarChar(100)
  notes          String?       @db.VarChar(255)
  reversedAt     DateTime?     @db.Timestamptz(3)
  reversalReason String?       @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([gymId, paymentDate])
  @@index([gymId, memberId])
  @@index([gymId, membershipId])
  @@index([gymId, status])
}

model Attendance {
  id                 String    @id @default(uuid()) @db.Uuid
  gymId              String    @db.Uuid
  memberId           String    @db.Uuid
  membershipId       String?   @db.Uuid
  attendanceDate     DateTime  @db.Date
  checkedInAt        DateTime  @default(now()) @db.Timestamptz(3)
  source             String?   @db.VarChar(30)
  cancelled          Boolean   @default(false)
  activeKey          String?   @db.VarChar(10)
  cancelledAt        DateTime? @db.Timestamptz(3)
  cancellationReason String?   @db.VarChar(255)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  gym        Gym         @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([gymId, memberId, attendanceDate, activeKey])
  @@index([gymId, attendanceDate])
  @@index([gymId, checkedInAt])
  @@index([gymId, memberId, checkedInAt])
}

enum EventType {
  CLASS
  WORKSHOP
  COMPETITION
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model Event {
  id                       String      @id @default(uuid()) @db.Uuid
  gymId                    String      @db.Uuid
  name                     String      @db.VarChar(150)
  description              String?     @db.VarChar(1000)
  type                     EventType
  status                   EventStatus @default(DRAFT)
  startDate                DateTime
  endDate                  DateTime
  capacity                 Int
  price                    Decimal     @default(0) @db.Decimal(10, 2)
  requiresActiveMembership Boolean     @default(false)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Restrict)

  reservations Reservation[]

  @@index([gymId, status])
  @@index([gymId, type])
  @@index([gymId, startDate])
  @@index([gymId, status, startDate])
}

enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum ReservationPaymentStatus {
  NOT_REQUIRED
  PENDING
  PARTIALLY_PAID
  PAID
}

model Reservation {
  id       String @id @default(uuid()) @db.Uuid
  gymId    String @db.Uuid
  eventId  String @db.Uuid
  memberId String @db.Uuid

  status        ReservationStatus
  paymentStatus ReservationPaymentStatus

  amount Decimal @db.Decimal(10, 2)

  reservedAt  DateTime  @default(now()) @db.Timestamptz(3)
  paidAt      DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  payments EventPayment[]

  @@index([gymId, eventId, status])
  @@index([gymId, memberId])
  @@index([gymId, paymentStatus])
}

model EventPayment {
  id            String @id @default(uuid()) @db.Uuid
  gymId         String @db.Uuid
  reservationId String @db.Uuid

  amount Decimal       @db.Decimal(10, 2)
  method PaymentMethod
  status PaymentStatus @default(COMPLETED)

  reference String? @db.VarChar(100)
  notes     String? @db.VarChar(500)

  paymentDate DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  gym         Gym         @relation(fields: [gymId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([gymId, reservationId])
  @@index([gymId, paymentDate])
  @@index([gymId, status])
}
